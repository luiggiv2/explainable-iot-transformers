# ---- Environment / caches ----
.venv/
__pycache__/
**/__pycache__/
*.pyc
.DS_Store
**/.DS_Store

# ---- CICIoT2023 dataset: NOT redistributed (see README; download from CIC) ----
data/raw/

# ---- Derived dataset rows (regenerable via scripts 01-02; excluded for size
#      and to respect the CIC dataset terms) ----
data/subset_60k.parquet
data/splits/
data/serialized/

# Revised leakage-safe experiment workspace. Compact metrics/manifests under
# data/revision/results remain trackable; regenerated rows and models do not.
data/revision/subset_60k.parquet
data/revision/splits/
data/revision/serialized/
data/revision/models/
data/revision/runs/**/model/
data/revision/runs/**/models/

# ---- Trained models (regenerable via scripts 03-04; large) ----
data/models/

# ---- Transient logs ----
data/*.log
*.log

# Everything else under data/ (metrics CSVs, confusion matrices, *_findings.md,
# stats artifacts, figures/, small analysis parquets) IS tracked as the paper's
# evidence.

# Resume checkpoints (duplicates of the final per-sample files)
data/revision/**/*_progress.parquet
